{
  "manifest_version": 3,
  "name": "Deskriptions Chromium Adapter",
  "version": "1.0.9",
  "key": "",
  "description": "Local adapter for saving and loading Deskriptions Desktops in Chrome, Brave, and Microsoft Edge.",
  "permissions": ["tabs", "windows", "storage", "nativeMessaging", "alarms", "favicon"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": { "default_title": "Reconnect Deskriptions" }
}

